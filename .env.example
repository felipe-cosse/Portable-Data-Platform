# Local platform credentials. Replace every CHANGE_ME value outside local development.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=platform
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
CLICKHOUSE_SECURE=0

DAGSTER_PG_HOST=dagster-postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=CHANGE_ME_dagster

# Connector configuration
SOURCE_CONFIG_PATH=/opt/data-platform/config/sources.yml
DLT_PIPELINES_DIR=/opt/dagster/dlt
DLT_TELEMETRY=false
DBT_PROJECT_DIR=/opt/data-platform/dbt
DBT_PROFILES_DIR=/opt/data-platform/dbt
DBT_TARGET=local

# Local S3-compatible storage (MinIO). AWS uses the instance role instead.
DATA_LAKE_BUCKET=local-data-lake
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio
AWS_DEFAULT_REGION=us-west-2

# Optional local demo database sources.
SOURCE_POSTGRES_URL=postgresql+psycopg2://source:source@source-postgres:5432/source
SOURCE_MYSQL_URL=mysql+pymysql://source:source@source-mysql:3306/source

# Optional API token used by config/sources.yml examples.
EXAMPLE_API_TOKEN=
