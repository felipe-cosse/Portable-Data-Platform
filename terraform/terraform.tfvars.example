name                = "data-platform"
aws_region          = "us-west-2"
architecture        = "arm64"
instance_type       = "t4g.large"
cpu_credits         = "standard"
root_volume_size_gb = 80
enable_metabase     = true
bucket_force_destroy = false

tags = {
  Environment = "dev"
  Owner       = "data-team"
}
