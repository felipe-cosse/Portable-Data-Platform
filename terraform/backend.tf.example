# Configure a remote backend before using this with a team or production.
# The bucket and DynamoDB table must already exist.
terraform {
  backend "s3" {
    bucket         = "REPLACE_ME-terraform-state"
    key            = "data-platform/terraform.tfstate"
    region         = "us-west-2"
    encrypt        = true
    dynamodb_table = "REPLACE_ME-terraform-locks"
  }
}
